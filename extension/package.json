{
    "name": "nexius-release-dashboard",
    "description": "Nexius Release Dashboard — Azure DevOps deployment overview extension",
    "author": "Bitwit Zrt.",
    "license": "MIT",
    "private": true,
    "scripts": {
        "clean": "rimraf ./dist ./out",
        "compile": "npm run clean && webpack --mode production",
        "compile:dev": "npm run clean && webpack --mode development",
        "test": "jest",
        "test:watch": "jest --watch",
        "check": "npx tsc --noEmit",
        "package": "npm run compile && tfx extension create --manifest-globs vss-extension.json --overrides-file configs/nexius.json --output-path out",
        "package:dev": "npm run compile:dev && tfx extension create --manifest-globs vss-extension.json --overrides-file configs/dev.json --output-path out",
        "publish": "npm run compile && tfx extension publish --manifest-globs vss-extension.json --overrides-file configs/nexius.json --output-path out",
        "publish:dev": "npm run compile:dev && tfx extension publish --manifest-globs vss-extension.json --overrides-file configs/dev.json --output-path out",
        "start:dev": "webpack-dev-server --mode development",
        "tfx-create": "tfx extension create --manifest-globs vss-extension.json",
        "prettier:write": "prettier --write '**/*.{js,ts,jsx,tsx,css,scss,htm,html}'",
        "prettier:check": "prettier --check '**/*.{js,ts,jsx,tsx,css,scss,htm,html}'"
    },
    "dependencies": {
        "@microsoft/applicationinsights-web": "^3.3.0",
        "azure-devops-extension-api": "^5.275.0",
        "azure-devops-extension-sdk": "^4.0.2",
        "azure-devops-ui": "^2.257.0",
        "react": "^16.8.6",
        "react-dom": "^16.8.6"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@jest/globals": "^30.4.1",
        "@testing-library/dom": "^10.3.2",
        "@testing-library/jest-dom": "^6.4.6",
        "@testing-library/react": "^12.1.5",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "^29.5.12",
        "@types/react": "^16.8.18",
        "@types/react-dom": "^16.8.4",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.66.0",
        "babel-jest": "^30.0.1",
        "base64-inline-loader": "^2.0.1",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.2",
        "eslint": "^9.35.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.5.4",
        "file-loader": "^6.2.0",
        "jest": "^30.0.5",
        "jest-dom": "^4.0.0",
        "jest-environment-jsdom": "^30.0.5",
        "prettier": "^3.3.3",
        "rimraf": "^6.0.1",
        "sass": "^1.102.0",
        "sass-loader": "^14.2.1",
        "style-loader": "^4.0.0",
        "tfx-cli": "^0.23.4",
        "ts-jest": "^29.4.1",
        "ts-loader": "^9.5.2",
        "typescript": "^5.9.2",
        "vss-web-extension-sdk": "^5.141.0",
        "webpack": "^5.94.0",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.6"
    },
    "overrides": {
        "ts-jest": {
            "@babel/core": "$@babel/core"
        }
    },
    "engines": {
        "npm": ">=8",
        "node": ">=22"
    }
}
